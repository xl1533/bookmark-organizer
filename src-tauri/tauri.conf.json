{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BookmarkOrganizer",
  "version": "0.1.0",
  "identifier": "com.bookmarkorganizer.desktop",
  "build": {
    "beforeDevCommand": {
      "cwd": "../ui",
      "script": "npm run dev"
    },
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": {
      "cwd": "../ui",
      "script": "npm run build"
    },
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "书签整理工具 Bookmark Organizer",
        "width": 1200,
        "height": 800,
        "minWidth": 940,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "copyright": "MIT",
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
